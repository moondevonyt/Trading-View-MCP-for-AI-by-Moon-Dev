# 🌙 Moon Dev's TradingView MCP config
# Copy this file to .env and edit as needed.

# Chrome remote debugging port (default 9222, change if you already use it)
TV_MCP_CDP_PORT=9222

# Dedicated Chrome profile dir (kept separate from your regular Chrome)
TV_MCP_CHROME_PROFILE_DIR=~/.tradingview_mcp_chrome

# URL that the dedicated Chrome opens on launch
TV_MCP_START_URL=https://www.tradingview.com/chart/

# Path to Chrome binary. Leave empty to auto-detect per-OS.
TV_MCP_CHROME_BINARY=

# Log file for tool calls (JSON lines). Leave empty to disable.
TV_MCP_LOG_FILE=~/.tradingview_mcp_chrome/tool_calls.jsonl
