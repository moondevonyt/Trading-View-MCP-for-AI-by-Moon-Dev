//@version=5
// Moon Dev's GEX Arrows v1 - just green = buy, red = sell. No labels, no sweep lines.
// A signal needs BOTH:
//   1) a fresh wall-rejection OR a stop-run reclaim (one of two reversal patterns)
//   2) no other signal in the last `cooldown` bars (so they don't cluster)
// Optionally restricted to RTH so the indicator doesn't fire in thin overnight tape.
// All conditions are gated on barstate.isconfirmed so arrows never flicker.
indicator("Moon Dev GEX Arrows", shorttitle="MD_GEX_ARR", overlay=true,
          max_lines_count=200, max_labels_count=50)

// =============================================================
// INPUTS
// =============================================================
grpInst    = "Instrument"
instSel    = input.string("SPY", "Instrument", options=["SPY","ES"], group=grpInst)
spyMajor   = input.float(5.0,  "SPY strike spacing", group=grpInst)
esMajor    = input.float(25.0, "ES  strike spacing", group=grpInst)
numStrikes = input.int(3,      "Strikes drawn each side", minval=1, maxval=10, group=grpInst)

grpSig = "Signal tuning"
trapWin  = input.int(2,  "Trap pierce lookback (bars)", minval=1, maxval=5,  group=grpSig)
swpWin   = input.int(2,  "Sweep window (bars)",         minval=1, maxval=5,  group=grpSig)
pivLen   = input.int(5,  "Sweep pivot lookback",        minval=2, maxval=20, group=grpSig)
cooldown = input.int(5,  "Cooldown between signals (bars)", minval=0, maxval=30, group=grpSig)
rthOnly  = input.bool(true, "Only fire during RTH 09:30-16:00 ET", group=grpSig)
needVol  = input.bool(true, "Wall trap requires below-avg volume", group=grpSig)

grpVis = "Visuals"
showVwap  = input.bool(true,  "Show session VWAP",   group=grpVis)
showWalls = input.bool(true,  "Show option walls",   group=grpVis)

stepMajor = instSel == "SPY" ? spyMajor : esMajor

// =============================================================
// SESSION CONTEXT
// =============================================================
inRTH = not na(time(timeframe.period, "0930-1600", "America/New_York"))
rthOk = not rthOnly or inRTH

var float cumPV  = na
var float cumVol = na
newSession = ta.change(time("D")) != 0
if newSession
    cumPV  := 0.0
    cumVol := 0.0
tp = (high + low + close) / 3.0
cumPV  := nz(cumPV)  + tp * nz(volume, 1)
cumVol := nz(cumVol) + nz(volume, 1)
sessVwap = cumVol > 0 ? cumPV / cumVol : close
plot(showVwap ? sessVwap : na, "Moon Dev VWAP", color=color.new(color.yellow, 50), linewidth=1)

// =============================================================
// OPTION WALLS (drawn once on last bar - faint, just context)
// =============================================================
roundTo(_x, _step) => math.round(_x / _step) * _step

var line[]  wallLs   = array.new_line()
var label[] wallLbls = array.new_label()

cleanupLs(arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            line.delete(array.get(arr, i))
        array.clear(arr)
cleanupLbls(arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            label.delete(array.get(arr, i))
        array.clear(arr)

if showWalls and barstate.islast
    cleanupLs(wallLs)
    cleanupLbls(wallLbls)
    bp = close
    for i = -numStrikes to numStrikes
        lvl = roundTo(bp, stepMajor) + i * stepMajor
        col = lvl > bp ? color.new(color.red, 60) : color.new(color.green, 60)
        ln = line.new(bar_index - 50, lvl, bar_index + 10, lvl, color=col, width=1)
        array.push(wallLs, ln)
        lb = label.new(bar_index + 10, lvl, str.tostring(lvl, "#"),
                       color=color.new(color.black, 100), textcolor=col,
                       style=label.style_label_left, size=size.tiny)
        array.push(wallLbls, lb)

// =============================================================
// WALL TRAP (rejection at a major strike)
//   Bull trap (SELL): prior bar(s) high pierced the call wall,
//                     this bar closes back below the wall AND red.
//   Bear trap (BUY) : prior bar(s) low pierced the put wall,
//                     this bar closes back above the wall AND green.
// =============================================================
nearestCallWall = roundTo(close, stepMajor) + stepMajor
nearestPutWall  = roundTo(close, stepMajor) - stepMajor
volMA   = ta.sma(volume, 20)
volOk   = not needVol or volume < volMA

piercedAbove = ta.highest(high, trapWin)[1] > nearestCallWall[1]
piercedBelow = ta.lowest (low,  trapWin)[1] < nearestPutWall[1]

bullTrap = piercedAbove and close < nearestCallWall and close < open and volOk
bearTrap = piercedBelow and close > nearestPutWall  and close > open and volOk

// =============================================================
// LIQUIDITY SWEEP (stop-run + reclaim of a recent pivot)
// =============================================================
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow (low,  pivLen, pivLen)

var float lastPH    = na
var int   lastPHbar = na
var float lastPL    = na
var int   lastPLbar = na
if not na(ph)
    lastPH    := ph
    lastPHbar := bar_index - pivLen
if not na(pl)
    lastPL    := pl
    lastPLbar := bar_index - pivLen

sweepHi = not na(lastPH) and (bar_index - lastPHbar) <= (swpWin + pivLen) and ta.highest(high, swpWin) > lastPH and close < lastPH
sweepLo = not na(lastPL) and (bar_index - lastPLbar) <= (swpWin + pivLen) and ta.lowest (low,  swpWin) < lastPL and close > lastPL

// =============================================================
// COMBINE + COOLDOWN + ARROWS
// =============================================================
rawSell = bullTrap or sweepHi
rawBuy  = bearTrap or sweepLo

var int lastSigBar = na
canFire = na(lastSigBar) or (bar_index - lastSigBar) > cooldown

sellSignal = barstate.isconfirmed and rthOk and canFire and rawSell
buySignal  = barstate.isconfirmed and rthOk and canFire and rawBuy and not sellSignal

if sellSignal or buySignal
    lastSigBar := bar_index

plotshape(buySignal,  title="Moon Dev BUY",  style=shape.triangleup,
          location=location.belowbar, color=color.new(color.lime, 0),
          size=size.normal, text="BUY", textcolor=color.white)
plotshape(sellSignal, title="Moon Dev SELL", style=shape.triangledown,
          location=location.abovebar, color=color.new(color.red, 0),
          size=size.normal, text="SELL", textcolor=color.white)

// =============================================================
// ALERTS
// =============================================================
alertcondition(buySignal,  title="Moon Dev BUY",  message="Moon Dev: BUY arrow")
alertcondition(sellSignal, title="Moon Dev SELL", message="Moon Dev: SELL arrow")
